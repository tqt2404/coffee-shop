{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile synced with Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Specialty coffee order placed by an authenticated customer.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^LS-[0-9]{6}-[0-9]{4}$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 9,
          "maxLength": 24
        },
        "customerAddress": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "customerCity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerNote": {
          "type": "string",
          "maxLength": 300
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "bank-transfer"]
        },
        "items": {
          "type": "array",
          "description": "Bounded list of up to 30 ordered coffee line items."
        },
        "subtotal": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "shippingFee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "promoApplied": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "roasting", "shipped", "completed", "cancelled"]
        },
        "statusLabel": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerName",
        "customerPhone",
        "customerAddress",
        "customerCity",
        "customerNote",
        "paymentMethod",
        "items",
        "subtotal",
        "discountAmount",
        "shippingFee",
        "total",
        "promoApplied",
        "status",
        "statusLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "TastingBooking": {
      "title": "TastingBooking",
      "description": "Cupping and tasting session reservation at a Lac Son branch.",
      "type": "object",
      "properties": {
        "bookingCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^LS-CUP-[0-9]{4}$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branchId": {
          "type": "string",
          "enum": ["dalat", "hanoi"]
        },
        "branchName": {
          "type": "string",
          "maxLength": 120
        },
        "guestName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "guestPhone": {
          "type": "string",
          "minLength": 9,
          "maxLength": 24
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 24
        },
        "guests": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingCode",
        "userId",
        "branchId",
        "branchName",
        "guestName",
        "guestPhone",
        "date",
        "timeSlot",
        "guests",
        "note",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Server-managed admin registry document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "CoffeeProduct": {
      "title": "CoffeeProduct",
      "description": "Specialty coffee catalog product managed exclusively by verified admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["single-origin", "phin-blend", "cold-brew"]
        },
        "categoryLabel": {
          "type": "string",
          "maxLength": 60
        },
        "origin": {
          "type": "string",
          "maxLength": 120
        },
        "elevation": {
          "type": "string",
          "maxLength": 60
        },
        "process": {
          "type": "string",
          "maxLength": 100
        },
        "roastLevel": {
          "type": "string",
          "enum": ["Rang sáng", "Rang sáng vừa", "Rang vừa", "Rang đậm"]
        },
        "tastingNotes": {
          "type": "array",
          "description": "Bounded list of up to 6 flavor notes."
        },
        "sensoryProfile": {
          "type": "object",
          "description": "5-axis sensory scores from 1 to 5."
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "basePrice": {
          "type": "number"
        },
        "defaultWeight": {
          "type": "string",
          "enum": ["250g", "500g", "1kg", "350ml"]
        },
        "availableWeights": {
          "type": "array"
        },
        "availableGrinds": {
          "type": "array"
        },
        "batchCode": {
          "type": "string",
          "maxLength": 32
        },
        "stock": {
          "type": "number"
        },
        "statusNote": {
          "type": "string",
          "maxLength": 80
        },
        "image": {
          "type": "string",
          "maxLength": 300
        },
        "imageAlt": {
          "type": "string",
          "maxLength": 240
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "subtitle",
        "category",
        "categoryLabel",
        "origin",
        "elevation",
        "process",
        "roastLevel",
        "tastingNotes",
        "sensoryProfile",
        "description",
        "basePrice",
        "defaultWeight",
        "availableWeights",
        "availableGrinds",
        "batchCode",
        "stock",
        "statusNote",
        "image",
        "imageAlt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile isolated strictly to the owning user or admin."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer coffee orders with owner-scoped queries and strict state locking."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/TastingBooking" },
      "description": "Tasting and cupping reservations at Dalat or Hanoi branches."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/CoffeeProduct" },
      "description": "Public storefront coffee catalog writable exclusively by verified admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Read-only admin directory preventing client-side role escalation."
    }
  }
}
