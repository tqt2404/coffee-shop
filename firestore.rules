rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // === Global Hardened Primitives ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'tqt2k40424@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // === Validation Blueprints ===
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerPhone',
          'customerAddress', 'customerCity', 'customerNote', 'paymentMethod',
          'items', 'subtotal', 'discountAmount', 'shippingFee', 'total',
          'promoApplied', 'status', 'statusLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerPhone',
          'customerAddress', 'customerCity', 'customerNote', 'paymentMethod',
          'items', 'subtotal', 'discountAmount', 'shippingFee', 'total',
          'promoApplied', 'status', 'statusLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.orderNumber is string && data.orderNumber.size() <= 40 && data.orderNumber.matches('^LS-[0-9]{6}-[0-9]{4}$') &&
        data.userId is string && isValidId(data.userId) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 9 && data.customerPhone.size() <= 24 &&
        data.customerAddress is string && data.customerAddress.size() >= 8 && data.customerAddress.size() <= 240 &&
        data.customerCity is string && data.customerCity.size() >= 2 && data.customerCity.size() <= 80 &&
        data.customerNote is string && data.customerNote.size() <= 300 &&
        data.paymentMethod is string && data.paymentMethod in ['cod', 'bank-transfer'] &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 30 && data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discountAmount is number && data.discountAmount >= 0 &&
        data.shippingFee is number && data.shippingFee >= 0 &&
        data.total is number && data.total >= 0 &&
        data.promoApplied is string && data.promoApplied.size() <= 32 &&
        data.status is string && data.status in ['confirmed', 'roasting', 'shipped', 'completed', 'cancelled'] &&
        data.statusLabel is string && data.statusLabel.size() >= 2 && data.statusLabel.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTastingBooking(data) {
      return data.keys().hasAll([
          'bookingCode', 'userId', 'branchId', 'branchName', 'guestName',
          'guestPhone', 'date', 'timeSlot', 'guests', 'note',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bookingCode', 'userId', 'branchId', 'branchName', 'guestName',
          'guestPhone', 'date', 'timeSlot', 'guests', 'note',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.bookingCode is string && data.bookingCode.size() <= 32 && data.bookingCode.matches('^LS-CUP-[0-9]{4}$') &&
        data.userId is string && isValidId(data.userId) &&
        data.branchId is string && data.branchId in ['dalat', 'hanoi'] &&
        data.branchName is string && data.branchName.size() >= 2 && data.branchName.size() <= 120 &&
        data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 120 &&
        data.guestPhone is string && data.guestPhone.size() >= 9 && data.guestPhone.size() <= 24 &&
        data.date is string && data.date.size() <= 20 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 24 &&
        data.guests is number && data.guests >= 1 && data.guests <= 12 &&
        data.note is string && data.note.size() <= 300 &&
        data.status is string && data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'subtitle', 'category', 'categoryLabel',
          'origin', 'elevation', 'process', 'roastLevel', 'tastingNotes',
          'sensoryProfile', 'description', 'basePrice', 'defaultWeight',
          'availableWeights', 'availableGrinds', 'batchCode', 'stock',
          'statusNote', 'image', 'imageAlt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'name', 'subtitle', 'category', 'categoryLabel',
          'origin', 'elevation', 'process', 'roastLevel', 'tastingNotes',
          'sensoryProfile', 'description', 'basePrice', 'defaultWeight',
          'availableWeights', 'availableGrinds', 'isSingleUnit', 'batchCode',
          'stock', 'statusNote', 'image', 'imageAlt', 'updatedAt'
        ]) &&
        data.id is string && data.id == productId && isValidId(data.id) &&
        data.slug is string && isValidId(data.slug) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() >= 3 && data.subtitle.size() <= 160 &&
        data.category is string && data.category in ['single-origin', 'phin-blend', 'cold-brew'] &&
        data.categoryLabel is string && data.categoryLabel.size() >= 2 && data.categoryLabel.size() <= 60 &&
        data.origin is string && data.origin.size() >= 2 && data.origin.size() <= 120 &&
        data.elevation is string && data.elevation.size() >= 2 && data.elevation.size() <= 60 &&
        data.process is string && data.process.size() >= 2 && data.process.size() <= 100 &&
        data.roastLevel is string && data.roastLevel in ['Rang sáng', 'Rang sáng vừa', 'Rang vừa', 'Rang đậm'] &&
        data.tastingNotes is list && data.tastingNotes.size() >= 1 && data.tastingNotes.size() <= 6 && data.tastingNotes[0] is string &&
        data.sensoryProfile is map &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 600 &&
        data.basePrice is number && data.basePrice >= 20000 && data.basePrice <= 50000000 &&
        data.defaultWeight is string && data.defaultWeight in ['250g', '500g', '1kg', '350ml'] &&
        data.availableWeights is list && data.availableWeights.size() >= 1 && data.availableWeights.size() <= 4 && data.availableWeights[0] is string &&
        data.availableGrinds is list && data.availableGrinds.size() >= 1 && data.availableGrinds.size() <= 5 && data.availableGrinds[0] is string &&
        (!('isSingleUnit' in data) || data.isSingleUnit is bool) &&
        data.batchCode is string && data.batchCode.size() >= 2 && data.batchCode.size() <= 32 &&
        data.stock is number && data.stock >= 0 && data.stock <= 10000 &&
        data.statusNote is string && data.statusNote.size() <= 80 &&
        data.image is string && data.image.size() >= 5 && data.image.size() <= 300 &&
        data.imageAlt is string && data.imageAlt.size() >= 2 && data.imageAlt.size() <= 240 &&
        data.updatedAt is timestamp;
    }

    // === Collection: /admins/{adminId} ===
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if false;
    }

    // === Collection: /products/{productId} (Public Read, Admin-Only Write) ===
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // === Collection: /users/{userId} (PII Isolated) ===
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']))
        );
      allow delete: if false;
    }

    // === Collection: /orders/{orderId} ===
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isBootstrapAdmin()
      );
      allow create: if isVerified() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            !(existing().status in ['completed', 'cancelled']) &&
            existing().status == 'confirmed' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusLabel', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // === Collection: /bookings/{bookingId} ===
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isBootstrapAdmin()
      );
      allow create: if isVerified() &&
        isValidId(bookingId) &&
        isValidTastingBooking(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(bookingId) &&
        isValidTastingBooking(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().bookingCode == existing().bookingCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            !(existing().status in ['completed', 'cancelled']) &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }
  }
}
